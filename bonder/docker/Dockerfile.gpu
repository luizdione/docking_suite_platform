# =============================================================================
# bonder - imagem GPU (opcional): CUDA 12.4 + PyTorch cu124 + ferramentas de
# deep learning consagradas. Usada apenas para etapas OPCIONAIS aceleradas na
# RTX 3060: DIA-NN (busca DIA), MS2Rescore/AlphaPeptDeep (rescoring) e a
# priorizacao exploratoria ESM2. Todas com fallback CPU no codigo.
#
# Runtime (nao devel): nao precisamos de compilador CUDA para os wheels do torch.
# =============================================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip git ca-certificates \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-gpu.txt /app/
# torch cu124 + libs de rescoring/embeddings
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -r requirements-gpu.txt \
       --extra-index-url https://download.pytorch.org/whl/cu124

COPY . /app
RUN pip install --no-deps -e .

# DIA-NN e ColabFold NAO sao pip. Para habilita-los, adicione os binarios ao PATH:
#   - DIA-NN:    baixe o release Linux (aceite a licenca) e COPIE para /usr/local/bin/diann
#   - ColabFold: instale colabfold_batch (localcolabfold) e exponha no PATH
# Exemplo (descomente e ajuste a versao/licenca):
# COPY vendor/diann /usr/local/bin/diann

ENV BONDER_DATA_ROOT=/data BONDER_RUNS_DIR=/runs
# valida device (nunca deve quebrar; cai para CPU se sem GPU)
RUN python -c "from bonder.gpu.detect import probe; print(probe().to_dict())" || true
CMD ["python", "-c", "from bonder.gpu.detect import probe; print(probe().to_dict())"]
